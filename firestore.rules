rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return userExists() && getUserData().role == 'admin';
    }

    function isApprovedTrainer() {
      return userExists()
        && getUserData().role == 'trainer'
        && getUserData().status == 'approved';
    }

    function isStaff() {
      return isAdmin() || isApprovedTrainer();
    }

    match /users/{userId} {
      // Profiles contain personal information. A user can read only their own profile;
      // administrators can review and manage profiles.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Clients may create only a pending student stub for their authenticated email.
      // A trusted callable function promotes it after matching the private roster.
      allow create: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.email == request.auth.token.email
          && (
            (request.resource.data.keys().hasOnly(['email', 'role', 'status'])
              && request.resource.data.role == 'student'
              && request.resource.data.status == 'pending')
            || (request.resource.data.keys().hasOnly(['name', 'email', 'department', 'role', 'status', 'createdAt'])
              && request.resource.data.role == 'trainer'
              && request.resource.data.status == 'pending')
          ));

      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'mobile', 'updatedAt'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    match /settings/student_roster {
      // The roster contains student contact details. Read and write through staff pages
      // only; student lookup and registration use callable functions.
      allow read, write: if isStaff();
    }

    match /sessions/{sessionId} {
      // Session documents contain rotating QR tokens. Students submit scans to the
      // markAttendance callable and never read token-bearing session documents.
      allow read, write: if isStaff();
    }

    match /attendance/{sessionId} {
      allow read, write: if isStaff();

      match /records/{studentUid} {
        allow read: if isStaff() || isOwner(studentUid);
        // Client attendance writes bypass QR validation. Callable functions use Admin SDK.
        allow create, update, delete: if isStaff();
      }
    }

    match /{path=**}/records/{recordDoc} {
      allow read: if isStaff()
        || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if isStaff();
    }
  }
}

