rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return userExists() 
        && ('role' in getUserData()) 
        && getUserData().role == 'admin';
    }

    function isApprovedTrainer() {
      return userExists() 
        && ('role' in getUserData()) 
        && getUserData().role == 'trainer' 
        && ('status' in getUserData())
        && getUserData().status == 'approved';
    }

    function isStaff() {
      return isAdmin() || isApprovedTrainer();
    }

    // 1. Users collection: allow profile lookup & self-registration
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && (
          request.resource.data.role == 'student' ||
          (request.resource.data.role == 'trainer' && request.resource.data.status == 'pending')
        );
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Settings / Master Roster: readable by students for validation
    match /settings/student_roster {
      allow read: if true;
      allow write: if isStaff() || isAuthenticated();
    }

    // 3. Sessions collection: authenticated students can verify QR codes
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // 4. Attendance collection & records: students can mark their own attendance
    match /attendance/{sessionId} {
      allow read, write: if isStaff();

      match /records/{studentUid} {
        allow read, write: if isStaff() || isOwner(studentUid);
      }
    }

    // 5. Collection group query for attendance records history
    match /{path=**}/records/{recordDoc} {
      allow read: if isStaff()
        || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if isStaff()
        || (isAuthenticated() && request.resource.data.uid == request.auth.uid);
    }
  }
}
